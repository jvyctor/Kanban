generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  displayName String      @map("display_name")
  passwordHash String     @map("password_hash")
  appRole     AppRole     @default(USER) @map("app_role")
  memberships Membership[]
  cards       Card[]      @relation("CardAssignee")
  comments    CardComment[]
  sessions    Session[]
  passwordResetTokens PasswordResetToken[]
  invitations BoardInvitation[] @relation("InvitationRecipient")
  sentInvitations BoardInvitation[] @relation("InvitationSender")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  expiresAt  DateTime @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model BoardInvitation {
  id            String    @id @default(cuid())
  boardId        String    @map("board_id")
  invitedById    String    @map("invited_by_id")
  invitedUserId  String    @map("invited_user_id")
  invitedEmail   String    @map("invited_email")
  role           BoardRole
  tokenHash      String    @unique @map("token_hash")
  acceptedAt     DateTime? @map("accepted_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  board          Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy      User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser    User      @relation("InvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([invitedUserId])
  @@index([expiresAt])
  @@map("board_invitations")
}

model Board {
  id          String       @id @default(cuid())
  title       String
  description String?
  lists       BoardList[]
  memberships Membership[]
  invitations BoardInvitation[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("boards")
}

model Membership {
  id               String   @id @default(cuid())
  role             BoardRole
  canManageMembers Boolean  @default(false) @map("can_manage_members")
  canInviteMembers Boolean  @default(false) @map("can_invite_members")
  canCreateLists   Boolean  @default(false) @map("can_create_lists")
  canEditLists     Boolean  @default(false) @map("can_edit_lists")
  canCreateCards   Boolean  @default(false) @map("can_create_cards")
  canEditCards     Boolean  @default(false) @map("can_edit_cards")
  canMoveCards     Boolean  @default(false) @map("can_move_cards")
  canComment       Boolean  @default(true) @map("can_comment")
  boardId          String   @map("board_id")
  userId           String   @map("user_id")
  board            Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([boardId, userId])
  @@map("memberships")
}

model BoardList {
  id        String   @id @default(cuid())
  title     String
  position  Int
  boardId   String   @map("board_id")
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([boardId, position])
  @@map("board_lists")
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    CardPriority @default(MEDIUM)
  tags        String[]  @default([])
  position    Int
  dueDate     DateTime? @map("due_date")
  listId      String    @map("list_id")
  assigneeId  String?   @map("assignee_id")
  list        BoardList @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    CardComment[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([listId, position])
  @@map("cards")
}

model CardComment {
  id        String   @id @default(cuid())
  cardId    String   @map("card_id")
  userId    String   @map("user_id")
  content   String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([cardId])
  @@index([userId])
  @@map("card_comments")
}

enum BoardRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("board_role")
}

enum AppRole {
  ADMIN
  USER

  @@map("app_role")
}

enum CardPriority {
  LOW
  MEDIUM
  HIGH

  @@map("card_priority")
}
